set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_SYSTEM_VERSION 9)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(PS5_PAYLOAD_SDK "$ENV{PS5_PAYLOAD_SDK}" CACHE PATH "PS5 SDK root")
set(PS5_LLVM_ROOT "$ENV{PS5_LLVM_ROOT}" CACHE PATH "LLVM root")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES PS5_PAYLOAD_SDK PS5_LLVM_ROOT)
if(NOT EXISTS "${PS5_PAYLOAD_SDK}/target/include/stdio.h")
    message(FATAL_ERROR "PS5_PAYLOAD_SDK does not name an installed SDK")
endif()
if(NOT EXISTS "${PS5_LLVM_ROOT}/bin/clang.exe")
    message(FATAL_ERROR "PS5_LLVM_ROOT does not name the LLVM installation")
endif()

set(CMAKE_C_COMPILER "${PS5_LLVM_ROOT}/bin/clang.exe")
set(CMAKE_CXX_COMPILER "${PS5_LLVM_ROOT}/bin/clang++.exe")
set(CMAKE_ASM_COMPILER "${PS5_LLVM_ROOT}/bin/clang.exe")
set(CMAKE_C_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_CXX_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_ASM_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_AR "${PS5_LLVM_ROOT}/bin/llvm-ar.exe")
set(CMAKE_RANLIB "${PS5_LLVM_ROOT}/bin/llvm-ranlib.exe")
set(CMAKE_SYSROOT "${PS5_PAYLOAD_SDK}/target")
set(CMAKE_C_FLAGS_INIT
    "-fno-stack-protector -fno-plt -femulated-tls -isystem \"${PS5_PAYLOAD_SDK}/target/include\"")
set(CMAKE_CXX_FLAGS_INIT
    "-fno-stack-protector -fno-plt -femulated-tls -stdlib=libc++ -isystem \"${PS5_PAYLOAD_SDK}/target/include/c++/v1\" -isystem \"${PS5_PAYLOAD_SDK}/target/include\"")
set(CMAKE_ASM_FLAGS_INIT "-fno-stack-protector -femulated-tls")
set(CMAKE_FIND_ROOT_PATH "${PS5_PAYLOAD_SDK}/target")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
